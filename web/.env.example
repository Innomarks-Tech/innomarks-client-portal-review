# Prototype intake can be enabled after the Supabase migrations and verification checklist pass.
INQUIRIES_ENABLED=true
NOTIFICATIONS_ENABLED=false
SITE_URL=http://localhost:3000
SUPABASE_URL=
# Server-only. Never prefix privileged credentials with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Browser-safe credentials used only for Supabase Auth session cookies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
RATE_LIMIT_SECRET=
RESEND_API_KEY=
# Development: Innomarks Development <onboarding@resend.dev>
# Production: use the approved address on the verified Innomarks domain.
RESEND_FROM=
# Address that receives replies to client acknowledgements and staff responses.
RESEND_REPLY_TO=
# Internal recipient for the full new-enquiry notification.
INQUIRY_NOTIFICATION_TO=
# Development-only override. When set, all client emails are delivered here.
# Leave empty in production so messages go to the submitted client address.
RESEND_TEST_RECIPIENT=
# Client emails stay disabled for the prototype until a sending domain is approved.
STAFF_EMAIL_ENABLED=false
# Protects the retry endpoint /api/internal/email-dispatch.
CRON_SECRET=
